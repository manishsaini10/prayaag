APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Instagram Feed Module (Meta Graph API)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_REDIRECT_URI=/admin/instagram/oauth/callback
# FACEBOOK_GRAPH_VERSION=v23.0

# ── Security / Bot Protection ──────────────────────────────────────────────
# Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin/create)
# Choose "reCAPTCHA v3" type. Add your domain. Copy the site + secret keys.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Minimum reCAPTCHA score to accept a submission (0.0 = bot, 1.0 = human).
RECAPTCHA_MIN_SCORE=0.5

# ── Data Retention (GDPR / FERPA) ──────────────────────────────────────────
# Personal data in job_applications and enquiries is anonymised after N months.
# Set to 0 to disable automatic purging.
PERSONAL_DATA_RETENTION_MONTHS=24

# ── ClamAV Malware Scanning ────────────────────────────────────────────────
# Set CLAMAV_ENABLED=true and install clamav / clamdscan on your server.
CLAMAV_ENABLED=false
CLAMAV_BINARY=clamdscan
# fail_open=true: allow upload if ClamAV is unavailable (not recommended).
CLAMAV_FAIL_OPEN=false
